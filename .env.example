# --- Memory (required for the real demo) -------------------------------------
# Hindsight Cloud: sign up at https://ui.hindsight.vectorize.io, create an API key,
# then add promo code MEMHACK99 under Billing for $50 of credits.
MEMORY_BACKEND=hindsight
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=hsk_your_key_here
HINDSIGHT_BANK_ID=precedent-deccan-fresh-ap
# Self-hosted instead?  docker run -p 8888:8888 -p 9999:9999 ghcr.io/vectorize-io/hindsight:latest
# HINDSIGHT_API_URL=http://localhost:8888

# --- LLM (optional: without a key the agent decides from memory evidence only) --
GROQ_API_KEY=gsk_your_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3-32b

PORT=8000
